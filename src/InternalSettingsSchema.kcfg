<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name="oxygen-decoration-limrc"/>

    <group name="Windeco">

        <!-- title alignment -->
        <entry name="TitleAlignment" type="Enum">
            <choices>
                <choice name="AlignLeft" />
                <choice name="AlignCenter" />
                <choice name="AlignCenterFullWidth" />
                <choice name="AlignRight" />
                <choice name="TitleHidden" />
            </choices>
            <default>AlignCenterFullWidth</default>
        </entry>

        <entry name="HideCaptionWhenLimitedSpace" type="Bool">
            <default>true</default>
        </entry>
        <entry name="ShowCaptionOnHover" type="Bool">
            <default>false</default>
        </entry>
        <entry name="MinWidthForCaption" type="Int">
            <default>250</default>
            <min>0</min>
            <max>500</max>
        </entry>

        <!-- menu -->
        <entry name="MenuAlwaysShow" type="Bool">
            <default>true</default>
        </entry>
        <entry name="SearchEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="HamburgerMenu" type="Bool">
            <default>false</default>
        </entry>
        <entry name="ShowDisabledActions" type="Bool">
            <default>false</default>
        </entry>
        <entry name="SearchIgnoreTopLevel" type="Bool">
            <default>true</default>
        </entry>
        <entry name="SearchIgnoreSubMenus" type="Bool">
            <default>false</default>
        </entry>
        <entry name="SearchFuzzyMatching" type="Bool">
            <default>false</default>
        </entry>
        <entry name="MenuButtonHorzPadding" type="Int">
            <default>4</default>
        </entry>

        <entry name="UseSystemMenuFont" type="Bool">
            <default>false</default>
        </entry>

        <!-- animations -->
        <entry name="AnimationsEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="AnimationsDuration" type="Int">
            <default>250</default>
        </entry>

        <!-- other -->
        <entry name="LongPressEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="LongPressDuration" type="Int">
            <default>750</default>
            <min>500</min>
            <max>5000</max>
        </entry>

        <entry name="TilingPopupHoverEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="TilingPopupHoverDelay" type="Int">
            <default>750</default>
            <min>500</min>
            <max>5000</max>
        </entry>

        <entry name="DragFromButtonsEnabled" type="Bool">
            <default>true</default>
        </entry>

        <!-- exception options -->
        <entry name="ExceptionPattern" type="String">
            <default></default>
        </entry>
        <entry name="ExceptionType" type="Int">
            <default>1</default>
        </entry>
        <!-- 0: exact match; 1: literal substring match (formerly regular expression). -->
        <entry name="MatchingMode" type="Int">
            <default>0</default>
        </entry>
        <entry name="Enabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="Mask" type="Int">
            <default>0</default>
        </entry>
        <entry name="HideTitleBar" type="Bool">
            <default>false</default>
        </entry>
        <entry name="HideApplicationMenu" type="Bool">
            <default>false</default>
        </entry>
        <entry name="HideShadow" type="Bool">
            <default>false</default>
        </entry>
    </group>

</kcfg>
